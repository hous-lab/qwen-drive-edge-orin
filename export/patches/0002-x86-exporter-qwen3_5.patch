+# ---------------------------------------------------------------------------
+# Custom op: trt_edgellm::gated_rmsnorm  (fused GDN output norm + silu gate)
+# ---------------------------------------------------------------------------
+
+
+@torch.library.custom_op("trt_edgellm::gated_rmsnorm", mutates_args=())
+def gated_rmsnorm(
+    o: torch.Tensor,  # [batch, seq, num_v_heads, v_dim] float16 — GDN plugin output
+    z: torch.Tensor,  # [batch, seq, num_v_heads, v_dim] float16 — per-head gate
+    weight: torch.Tensor,  # [v_dim] float16 — RMSNorm weight
+    eps: float,
+) -> torch.Tensor:
+    """Stub: fused RMSNorm(o) * silu(z) * weight (FP16 I/O, fp32 math)."""
+    return torch.empty_like(o)
+
+
+@gated_rmsnorm.register_fake
+def _(o, z, weight, eps):
+    return torch.empty_like(o)
+
+
