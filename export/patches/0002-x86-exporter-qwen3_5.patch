+# ---------------------------------------------------------------------------
+# Custom op: trt_edgellm::vit_swiglu_plugin  (ViT SwiGLU TensorCore MLP)
+# ---------------------------------------------------------------------------
+# Fuses gate_proj + up_proj GEMMs into one TensorCore GEMM, then applies
+# SwiGLU activation and down_proj in a single plugin call.
+#
+# Weight layout (row-major):
+#   fused_weight: [hiddenDim, 2*intermediateDim]  — gate_proj || up_proj
+#   fused_bias:   [2*intermediateDim]              — gate_bias || up_bias  (optional)
+#   down_weight:  [hiddenDim, intermediateDim]     — down_proj weight
+#   down_bias:    [hiddenDim]                      — down_proj bias (optional)
+#
+# The C++ plugin expects weights in row-major format (PyTorch default).
+
+
+@torch.library.custom_op("trt_edgellm::vit_swiglu_plugin", mutates_args=())
+def vit_swiglu_plugin(
+    hidden_states: torch.Tensor,   # [numTokens, hiddenDim] FP16
+    fused_weight: torch.Tensor,    # [hiddenDim, 2*intermediateDim] FP16 row-major
+    fused_bias: Optional[torch.Tensor],  # [2*intermediateDim] FP16 optional
+    down_weight: torch.Tensor,     # [hiddenDim, intermediateDim] FP16 row-major
+    down_bias: Optional[torch.Tensor],  # [hiddenDim] FP16 optional
+    hidden_dim: int,
+    intermediate_dim: int,
+) -> torch.Tensor:  # [numTokens, hiddenDim] FP16
+    """Fused SwiGLU MLP via TensorCore plugin.
+
+    In eager mode, implements the full MLP as a fallback (for testing/debugging).
+    During dynamo/ONNX tracing, the register_fake shape propagation is used.
+    """
+    # Eager mode fallback: standard SiLU(gate(x)) * up(x) @ down_weight^T
+    # fused_weight is [H, 2*I]. For gate/up: F.linear expects [out_features, in_features].
+    # fused_weight[:, :I].T is [I, H] = [out_features, in_features] for gate_proj.
+    gate = torch.nn.functional.linear(
+        hidden_states, fused_weight[:, :intermediate_dim].T,
+        fused_bias[:intermediate_dim] if fused_bias is not None else None)
+    up = torch.nn.functional.linear(
+        hidden_states, fused_weight[:, intermediate_dim:].T,
+        fused_bias[intermediate_dim:] if fused_bias is not None else None)
+    hidden = torch.nn.functional.silu(gate) * up
+    # down_weight is [H, I] = [out_features, in_features] for down_proj.
+    return torch.nn.functional.linear(
+        hidden, down_weight,
+        down_bias if down_bias is not None else None)
+
+
+@vit_swiglu_plugin.register_fake
+def _(hidden_states, fused_weight, fused_bias, down_weight, down_bias,
+      hidden_dim, intermediate_dim):
+    return torch.empty_like(hidden_states)
+
+
+# ---------------------------------------------------------------------------
+# Custom op: trt_edgellm::vit_gelu_ffn_plugin  (ViT GELU FFN TensorCore MLP)
+# ---------------------------------------------------------------------------
+# Fuses fc1 + GELU + fc2 into a single TensorCore-optimized plugin call.
+# For Qwen3-VL visual encoder (GELU FFN, not SwiGLU).
+#
+# Weight layout (row-major):
+#   fc1_weight: [H, I]          — fc1 weight (hidden → intermediate)
+#   fc1_bias:   [I]             — fc1 bias (optional)
+#   fc2_weight: [I, H]          — fc2 weight (intermediate → hidden)
+#   fc2_bias:   [H]             — fc2 bias (optional)
+
+
+@torch.library.custom_op("trt_edgellm::vit_gelu_ffn_plugin", mutates_args=())
+def vit_gelu_ffn_plugin(
+    hidden_states: torch.Tensor,   # [N, H] FP16
+    fc1_weight: torch.Tensor,      # [H, I] FP16 row-major
+    fc1_bias: Optional[torch.Tensor],  # [I] FP16 optional
+    fc2_weight: torch.Tensor,      # [I, H] FP16 row-major
+    fc2_bias: Optional[torch.Tensor],  # [H] FP16 optional
+    hidden_dim: int,               # H
+    intermediate_dim: int,         # I
+) -> torch.Tensor:  # [N, H] FP16
+    """Fused GELU FFN MLP via TensorCore plugin."""
+    # Eager mode fallback: GELU(fc1(x)) @ fc2^T
+    hidden = torch.nn.functional.linear(hidden_states, fc1_weight.T, fc1_bias)
+    hidden = torch.nn.functional.gelu(hidden, approximate="tanh")
+    return torch.nn.functional.linear(hidden, fc2_weight.T, fc2_bias)
+
+
+@vit_gelu_ffn_plugin.register_fake
+def _(hidden_states, fc1_weight, fc1_bias, fc2_weight, fc2_bias, hidden_dim,
+      intermediate_dim):
+    return torch.empty_like(hidden_states)
+
+
