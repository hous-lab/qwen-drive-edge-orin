# Vision engine build configuration (Jetson AGX Orin, trtexec)
# fp16 with workspace 2GB, high optimization level, no builder cache.
# Input contract: 3 camera views per the f2_05 manifest (see configs/manifest_f2_05.env).
TRTEXEC_FLAGS="--fp16 --memPoolSize=workspace:2048 --builderOptimizationLevel=4 --noBuilderCache"
